{
  "crons": [
    {
      "path": "/api/worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/bookings/poll",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/availability/sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/pricing/run?horizon=near",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/pricing/run?horizon=mid",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/pricing/run?horizon=far",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/messages/send-links",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/messages/answer",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/bookings/retry",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/pricing/backtest",
      "schedule": "20 4 * * *"
    }
  ]
}
