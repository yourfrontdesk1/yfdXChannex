# Supabase project holding the schema in db/001_schema.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Channex. Staging is free and self serve, production is issued after certification.
CHANNEX_API_KEY=
CHANNEX_ENV=staging

# Shared secret Channex signs its webhook with, and the secret the worker route needs.
CHANNEX_WEBHOOK_SECRET=
WORKER_SECRET=
